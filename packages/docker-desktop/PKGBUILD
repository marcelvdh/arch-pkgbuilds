# Forked from the AUR docker-desktop package: https://aur.archlinux.org/packages/docker-desktop

pkgname=docker-desktop
pkgver=4.90.0
_revision=238679
pkgrel=1
pkgdesc="Docker Desktop is an easy-to-install application that enables you to locally build and share containerized applications and microservices."
arch=('x86_64')
url="https://www.docker.com/products/docker-desktop/"
license=('custom: Docker Agreement')
depends=('docker>=28.3.0' 'curl>=8.5.0' 'qemu>=8.0.4' 'libseccomp>=2.5.5' 'libcap-ng>=0.8.4' 'pass' 'desktop-file-utils' 'gtk3' 'libx11' 'shadow>=4.14.2')
conflicts=('docker-compose' 'docker-buildx' 'docker-debug' 'docker-mcp' 'docker-scout')
provides=('docker-compose' 'docker-buildx' 'docker-debug' 'docker-mcp' 'docker-scout')
options=('!strip' '!debug')
install='docker-desktop.install'
source=('docker-agreement.txt'
        "$pkgname-$pkgver-x86_64.tar.zst::https://desktop.docker.com/linux/main/amd64/$_revision/$pkgname-x86_64.pkg.tar.zst")
sha256sums=('888694f4412e253e2dbf2ca4612a43e7d833407282296c14d980735151b639de'
            '1f7e07a96e832209419f4b74f8ccc2ad2eb9c41f519bc79dbfa34c760188b811')

package() {
    cp -r "${srcdir}/opt" "${pkgdir}"
    install -Dm755 "${srcdir}"/usr/bin/* -t "${pkgdir}/usr/bin"
    install -Dm755 "${srcdir}"/usr/lib/docker/cli-plugins/* -t "${pkgdir}/usr/lib/docker/cli-plugins"
    install -Dm644 "${srcdir}"/usr/lib/systemd/user/* -t "${pkgdir}/usr/lib/systemd/user"
    install -Dm644 "${srcdir}"/usr/share/applications/* -t "${pkgdir}/usr/share/applications"
    install -Dm644 "${srcdir}/docker-agreement.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

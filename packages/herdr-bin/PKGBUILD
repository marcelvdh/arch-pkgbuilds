# Forked from the AUR herdr-bin package: https://aur.archlinux.org/packages/herdr-bin

pkgname=herdr-bin
pkgver=0.9.4
pkgrel=1
pkgdesc="Supervise multiple coding agents in one terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/herdrdev/herdr"
license=('Apache-2.0')
provides=("herdr=${pkgver}")
conflicts=('herdr')
options=('!strip' '!debug')
source_x86_64=("herdr-${pkgver}-x86_64::https://github.com/herdrdev/herdr/releases/download/v${pkgver}/herdr-linux-x86_64")
source_aarch64=("herdr-${pkgver}-aarch64::https://github.com/herdrdev/herdr/releases/download/v${pkgver}/herdr-linux-aarch64")
sha256sums_x86_64=('493304fbefb0ed0ea0455f373b47f48d24e8774bc7974f4c916ad2e937675b23')
sha256sums_aarch64=('9511cb70982c1ef115f232058e7ed7cf9640aa5a2c0ca78934cefda3aeb093fd')

build() {
	install -m755 "herdr-${pkgver}-${CARCH}" herdr
	for shell in bash zsh fish; do
		./herdr completion "$shell" > "herdr.$shell"
	done
}

package() {
	install -Dm755 herdr "${pkgdir}/usr/bin/herdr"
	install -Dm644 herdr.bash "${pkgdir}/usr/share/bash-completion/completions/herdr"
	install -Dm644 herdr.zsh "${pkgdir}/usr/share/zsh/site-functions/_herdr"
	install -Dm644 herdr.fish "${pkgdir}/usr/share/fish/vendor_completions.d/herdr.fish"
}
